# Copy to .env or export before deploy (do not commit secrets)
INGEST_API_KEY=dev-change-me-to-a-long-secret

# Deployed ingest URL (IngestUrl from `serverless info`). Uncomment and set after deploy.
# Sourced for the edge bridge; smoke_ingest.py uses it when set.
# INGEST_URL=https://xxxx.execute-api.us-east-1.amazonaws.com/v1/telemetry/batch

# Optional second rule:
# TEMP_C_THRESHOLD=55

# Optional smoke overrides (else resolved from CloudFormation / serverless info):
# STAGE=dev
# AWS_REGION=us-east-1
